---
import Wishlist from "../../components/Wishlist";
import "../../styles/global.css";

const wishlistApiUrl =
  import.meta.env.PUBLIC_WISHLIST_API_URL ??
  "https://api.wishlist.oliveirarleo.com";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f35" />
    <meta
      name="description"
      content="Share the little things that would make your Christmas merry. Create a wishlist and gather everyone's wishes in one place."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/recursive.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href="https://wishlist.oliveirarleo.com/" />
    <title>Christmas Wishlist · Oliveira R. Leo</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="https://wishlist.oliveirarleo.com/" aria-label="Christmas Wishlist home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M5 13h22v15H5zM3 9h26v6H3zM16 9v19" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M16 9c-3.5 0-7-1.3-7-4 0-1.5 1.2-2.5 2.7-2.5C14.5 2.5 16 9 16 9Zm0 0c3.5 0 7-1.3 7-4 0-1.5-1.2-2.5-2.7-2.5C17.5 2.5 16 9 16 9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </span>
          <span>wishlist<span class="brand-dot">.</span></span>
        </a>
        <div class="season-label">
          <span class="season-star" aria-hidden="true">✦</span>
          The season of giving
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <div class="eyebrow"><span></span> Christmas wishes, all in one place <span></span></div>
          <h1 id="page-title">A little wish.<br /><em>A lot of joy.</em></h1>
          <p>
            Share what would make your Christmas merry and find the perfect gift
            for the people you love.
          </p>
          <div class="hero-flourish" aria-hidden="true">
            <span></span><svg viewBox="0 0 24 24" fill="none"><path d="m12 2 2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2L12 2Z" stroke="currentColor" stroke-width="1.2" /></svg><span></span>
          </div>
        </section>

        <Wishlist
          client:load
          apiUrl={wishlistApiUrl}
          turnstileSiteKey={turnstileSiteKey}
        />
        <noscript>
          <p class="list-status error">
            Enable JavaScript to view the wishlist and add your wish.
          </p>
        </noscript>
      </main>

      <footer>
        <span>Made with a little Christmas magic</span>
        <span class="footer-star" aria-hidden="true">✦</span>
        <span>Give joy, not just gifts.</span>
      </footer>
    </div>

    <style is:global>
      :root {
        --accent: 176, 55, 48;
        --background: 250, 248, 242;
        --foreground: 31, 57, 48;
        --gray: 103, 112, 103;
        --gray-light: 235, 231, 220;
        --gray-dark: 54, 64, 58;
      }

      body {
        background: #faf8f2;
        color: #36403a;
        font-size: 17px;
        line-height: 1.6;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.18;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
      }

      button,
      input {
        font: inherit;
      }

      .page-shell {
        width: min(1120px, calc(100% - 64px));
        margin: 0 auto;
        position: relative;
      }

      .site-header {
        height: 104px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #dfded4;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: #173f35;
        text-decoration: none;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -0.7px;
      }

      .brand-mark {
        width: 39px;
        height: 39px;
        display: grid;
        place-items: center;
        background: #b03730;
        color: #fffaf1;
        border-radius: 50%;
      }

      .brand-mark svg {
        width: 25px;
        height: 25px;
      }

      .brand-dot {
        color: #b03730;
      }

      .season-label {
        color: #68736b;
        font-size: 13px;
        font-weight: 550;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .season-star {
        color: #b88a3e;
        font-size: 19px;
      }

      main {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
      }

      .hero {
        text-align: center;
        padding: 70px 0 65px;
      }

      .eyebrow {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 13px;
        color: #9a762f;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 2.1px;
        font-weight: 650;
        margin-bottom: 21px;
      }

      .eyebrow span {
        width: 26px;
        height: 1px;
        background: #c9b78e;
      }

      h1,
      h2,
      h3 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      .hero h1 {
        font-size: clamp(52px, 6.2vw, 76px);
        line-height: 1.02;
        letter-spacing: -2.8px;
        color: #173f35;
        margin: 0;
      }

      .hero h1 em {
        color: #b03730;
        font-weight: 400;
      }

      .hero > p {
        max-width: 530px;
        margin: 25px auto 0;
        color: #6b736d;
        font-size: 16px;
        line-height: 1.7;
      }

      .hero-flourish {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 28px;
        color: #b88a3e;
      }

      .hero-flourish svg {
        width: 17px;
        height: 17px;
      }

      .hero-flourish span {
        height: 1px;
        width: 38px;
        background: #ded8c8;
      }

      .wishlist-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 365px;
        align-items: start;
        gap: 50px;
        padding-bottom: 80px;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 23px;
      }

      .section-kicker {
        color: #b03730;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0 0 7px;
      }

      .section-heading h2,
      .form-card h2 {
        color: #173f35;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.5px;
        margin: 0;
      }

      .wish-count {
        color: #7c817a;
        font-size: 12px;
        margin-bottom: 3px;
        white-space: nowrap;
      }

      .wishlist {
        display: grid;
        gap: 17px;
      }

      astro-island {
        display: contents;
      }

      .list-status {
        margin: 16px 0 0;
        color: #858980;
        font-size: 12px;
        text-align: center;
      }

      .list-status.error {
        color: #a4453c;
      }

      .turnstile-container:empty {
        display: none;
      }

      .turnstile-container {
        margin: 16px 0 14px;
      }

      .author-card {
        border: 1px solid #e3e1d8;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.58);
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(34, 52, 43, 0.025);
      }

      .author-header {
        display: flex;
        align-items: center;
        padding: 20px 23px 17px;
        gap: 13px;
      }

      .avatar {
        width: 43px;
        height: 43px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #e6eee6;
        border: 1px solid #d8e3d7;
        color: #355a4a;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 20px;
      }

      .author-card:nth-child(even) .avatar {
        background: #f3e8df;
        border-color: #eadbd0;
        color: #a24b3e;
      }

      .author-details h3 {
        font-size: 22px;
        color: #27493e;
        margin: 0 0 1px;
      }

      .author-details p {
        margin: 0;
        color: #858980;
        font-size: 11px;
      }

      .author-sparkle {
        margin-left: auto;
        color: #c2a366;
        font-size: 22px;
      }

      .author-wishes {
        list-style: none;
        margin: 0;
        padding: 0 23px 10px;
      }

      .wish-item {
        display: flex;
        align-items: center;
        border-top: 1px solid #ebe9e1;
      }

      .wish-item a {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 0;
        text-decoration: none;
      }

      .wish-bullet {
        width: 5px;
        height: 5px;
        flex: 0 0 auto;
        border-radius: 50%;
        background: #bf9856;
      }

      .wish-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .wish-name {
        color: #414b44;
        font-size: 14px;
        line-height: 1.45;
        transition: color 160ms ease;
      }

      .wish-domain {
        color: #93978f;
        font-size: 10px;
        margin-top: 3px;
      }

      .wish-arrow {
        width: 16px;
        height: 16px;
        margin-left: auto;
        flex: 0 0 auto;
        color: #89978d;
        transition: transform 160ms ease, color 160ms ease;
      }

      .wish-item a:hover .wish-name,
      .wish-item a:hover .wish-arrow {
        color: #b03730;
      }

      .wish-item a:hover .wish-arrow {
        transform: translate(2px, -2px);
      }

      .remove-wish {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        padding: 0;
        margin-left: 7px;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #aaa9a1;
        cursor: pointer;
        opacity: 0.55;
        transition: opacity 150ms ease, background 150ms ease, color 150ms ease;
      }

      .remove-wish svg {
        width: 15px;
        height: 15px;
      }

      .wish-item:hover .remove-wish,
      .remove-wish:focus-visible {
        opacity: 1;
      }

      .remove-wish:hover {
        color: #b03730;
        background: #f4e9e4;
      }

      .remove-wish:disabled {
        cursor: wait;
        opacity: 0.45;
      }

      .form-column {
        position: sticky;
        top: 28px;
      }

      .form-card {
        position: relative;
        z-index: 1;
        background: #fffefb;
        border: 1px solid #e0ded3;
        border-radius: 14px;
        padding: 58px 32px 32px;
        box-shadow: 0 12px 35px rgba(42, 55, 45, 0.06);
      }

      .form-card::before {
        content: "";
        position: absolute;
        inset: 5px;
        border: 1px solid #f0eee6;
        border-radius: 10px;
        pointer-events: none;
      }

      .form-decoration {
        position: absolute;
        z-index: 2;
        top: 0;
        left: 50%;
        width: 55px;
        height: 55px;
        display: grid;
        place-items: center;
        margin: 0;
        border: 6px solid #faf8f2;
        box-sizing: content-box;
        border-radius: 50%;
        background: #173f35;
        color: #e6c783;
        transform: translate(-50%, -50%);
      }

      .form-decoration svg {
        width: 38px;
        height: 38px;
      }

      .form-card > .section-kicker,
      .form-card > h2,
      .form-intro {
        text-align: center;
      }

      .form-intro {
        color: #7a817a;
        font-size: 13px;
        line-height: 1.55;
        margin: 10px 0 24px;
      }

      form label {
        display: block;
        color: #43564c;
        font-size: 12px;
        font-weight: 600;
        margin: 17px 0 6px;
      }

      input {
        box-sizing: border-box;
        width: 100%;
        height: 43px;
        padding: 0 12px;
        border: 1px solid #dcded5;
        border-radius: 6px;
        background: #fff;
        color: #35483e;
        font-size: 13px;
        outline: none;
        transition: border-color 150ms ease, box-shadow 150ms ease;
      }

      input::placeholder {
        color: #acafa8;
      }

      input:focus {
        border-color: #779083;
        box-shadow: 0 0 0 3px rgba(53, 90, 74, 0.09);
      }

      .link-input {
        position: relative;
      }

      .link-input svg {
        position: absolute;
        top: 14px;
        left: 12px;
        width: 16px;
        height: 16px;
        color: #919a91;
        pointer-events: none;
      }

      .link-input input {
        padding-left: 36px;
      }

      .field-hint {
        margin: 6px 0 20px;
        color: #989c95;
        font-size: 10px;
      }

      form > button {
        width: 100%;
        height: 46px;
        border: 0;
        border-radius: 6px;
        background: #b03730;
        color: #fffaf4;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 13px;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(176, 55, 48, 0.15);
        transition: background 150ms ease, transform 150ms ease;
      }

      form > button svg {
        width: 17px;
        height: 17px;
        transition: transform 150ms ease;
      }

      form > button:hover {
        background: #982d28;
        transform: translateY(-1px);
      }

      form > button:disabled {
        cursor: wait;
        opacity: 0.65;
        transform: none;
      }

      form > button:hover svg {
        transform: translateX(3px);
      }

      form > button:focus-visible,
      .remove-wish:focus-visible,
      a:focus-visible {
        outline: 2px solid #b88a3e;
        outline-offset: 3px;
      }

      .form-status {
        min-height: 0;
        margin: 10px 0 0;
        color: #476a58;
        text-align: center;
        font-size: 11px;
      }

      .form-status.error {
        color: #a4453c;
      }

      .form-status:empty {
        display: none;
      }

      .storage-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin: 20px -8px -4px;
        padding-top: 16px;
        border-top: 1px solid #eeece5;
        color: #a0a29b;
        font-size: 9px;
      }

      .storage-note svg {
        width: 12px;
        height: 12px;
      }

      .empty-state {
        text-align: center;
        padding: 45px 20px;
        border: 1px dashed #d9d8cd;
        border-radius: 12px;
      }

      .empty-state > span {
        color: #b88a3e;
        font-size: 30px;
      }

      .empty-state h3 {
        margin: 8px 0 4px;
        font-size: 24px;
      }

      .empty-state p {
        margin: 0;
        color: #7c817a;
        font-size: 13px;
      }

      footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        min-height: 85px;
        border-top: 1px solid #e3e0d6;
        color: #8a8e85;
        font-size: 10px;
        letter-spacing: 0.3px;
      }

      .footer-star {
        color: #b88a3e;
        font-size: 12px;
      }

      @media (max-width: 900px) {
        .wishlist-layout {
          grid-template-columns: minmax(0, 1fr) 320px;
          gap: 28px;
        }

        .form-card {
          padding: 54px 24px 27px;
        }
      }

      @media (max-width: 720px) {
        .page-shell {
          width: min(100% - 32px, 580px);
        }

        .site-header {
          height: 82px;
        }

        .season-label {
          font-size: 9px;
          letter-spacing: 0.7px;
        }

        .hero {
          padding: 50px 0 63px;
        }

        .hero h1 {
          font-size: clamp(47px, 13vw, 65px);
          letter-spacing: -2px;
        }

        .hero > p {
          font-size: 15px;
        }

        .wishlist-layout {
          display: flex;
          flex-direction: column-reverse;
          gap: 52px;
          padding-bottom: 50px;
        }

        .form-column {
          position: relative;
          top: auto;
          width: 100%;
        }

        .form-card {
          width: 100%;
          box-sizing: border-box;
        }

        .wishes-section {
          width: 100%;
        }

        .remove-wish {
          opacity: 1;
        }
      }

      @media (max-width: 430px) {
        .season-label {
          max-width: 85px;
          text-align: right;
          line-height: 1.5;
        }

        .eyebrow {
          font-size: 9px;
          letter-spacing: 1.3px;
        }

        .eyebrow span {
          width: 14px;
        }

        .author-header,
        .author-wishes {
          padding-left: 17px;
          padding-right: 17px;
        }

        footer {
          flex-direction: column;
          gap: 1px;
          padding: 20px 0;
        }

        .footer-star {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
