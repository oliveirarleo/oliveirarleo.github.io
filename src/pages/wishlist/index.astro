---
import {
  PUBLIC_TURNSTILE_SITE_KEY,
  PUBLIC_WISHLIST_API_URL,
} from "astro:env/client";
import Wishlist from "../../components/Wishlist";
import "../../styles/global.css";
import "../../styles/wishlist.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f35" />
    <meta
      name="description"
      content="Share the little things that would make your Christmas merry. Create a wishlist and gather everyone's wishes in one place."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/recursive.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href="https://oliveirarleo.com/wishlist/" />
    <title>Christmas Wishlist · Oliveira R. Leo</title>
  </head>
  <body class="wishlist-page">
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/wishlist/" aria-label="Christmas Wishlist home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M5 13h22v15H5zM3 9h26v6H3zM16 9v19" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M16 9c-3.5 0-7-1.3-7-4 0-1.5 1.2-2.5 2.7-2.5C14.5 2.5 16 9 16 9Zm0 0c3.5 0 7-1.3 7-4 0-1.5-1.2-2.5-2.7-2.5C17.5 2.5 16 9 16 9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </span>
          <span>wishlist<span class="brand-dot">.</span></span>
        </a>
        <div class="season-label">
          <span class="season-star" aria-hidden="true">✦</span>
          The season of giving
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <div class="eyebrow"><span></span> Christmas wishes, all in one place <span></span></div>
          <h1 id="page-title">A little wish.<br /><em>A lot of joy.</em></h1>
          <p>
            Share what would make your Christmas merry and find the perfect gift
            for the people you love.
          </p>
          <div class="hero-flourish" aria-hidden="true">
            <span></span><svg viewBox="0 0 24 24" fill="none"><path d="m12 2 2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2L12 2Z" stroke="currentColor" stroke-width="1.2" /></svg><span></span>
          </div>
        </section>

        <Wishlist
          client:load
          apiUrl={PUBLIC_WISHLIST_API_URL}
          turnstileSiteKey={PUBLIC_TURNSTILE_SITE_KEY}
        />
        <noscript>
          <p class="list-status error">
            Enable JavaScript to view the wishlist and add your wish.
          </p>
        </noscript>
      </main>

      <footer>
        <span>Made with a little Christmas magic</span>
        <span class="footer-star" aria-hidden="true">✦</span>
        <span>Give joy, not just gifts.</span>
      </footer>
    </div>

  </body>
</html>
