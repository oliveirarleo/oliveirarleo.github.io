# Development overrides — loaded after .env by `pnpm dev:api`.
# Keep this file free of secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=8788
DATABASE_PATH=./data/wishes.db
ALLOWED_ORIGIN=http://localhost:4321
# Public, development-only Better Auth key. Never reuse this in production.
BETTER_AUTH_SECRET=development-only-wishlist-auth-key-000000
WISHLIST_SECRET_PEPPER=development-only-wishlist-pepper-000000
