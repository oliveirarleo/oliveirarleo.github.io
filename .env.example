# Base environment template — copy to .env.
#
# Layering:
#   .env         base/local defaults, loaded first
#   .dev.env     development overrides, loaded second by `pnpm dev:api`
#
# Production secrets are not stored in env files. Production uses sops-nix;
# export TURNSTILE_SECRET and BETTER_AUTH_SECRET only for local testing.
# .dev.env contains a public development-only Better Auth key.
#
# Existing shell/systemd environment variables win over all files.

# Frontend, read by Astro at build/dev time
#
# Local development:
PUBLIC_WISHLIST_API_URL=http://localhost:8788
#
# Production is set by the GitHub Actions workflow:
# PUBLIC_WISHLIST_API_URL=https://wishlist-api.oliveirarleo.com
#
# Cloudflare Dashboard -> Turnstile -> your widget -> Site Key
PUBLIC_TURNSTILE_SITE_KEY=

# API
# Development uses 8788 so it can run alongside the production service on 8787.
HOST=127.0.0.1
PORT=8788
DATABASE_PATH=./data/wishes.db

# Exact browser origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:4321
# Production:
# ALLOWED_ORIGIN=https://oliveirarleo.com

# NODE_ENV selects production checks: development (default) or production.
# Production refuses to start without TURNSTILE_SECRET.
# NODE_ENV=production

# TURNSTILE_SECRET enables Turnstile on the API in any environment. Leave it unset
# to skip verification locally. It is provided by sops/systemd in production:
# Cloudflare Dashboard -> Turnstile -> your widget -> Secret Key
# BETTER_AUTH_SECRET is also provided by sops/systemd (at least 32 random characters).
# TRUST_PROXY=true is only for the Cloudflare Tunnel in production.
